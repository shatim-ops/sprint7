# Языковая модель: любой эндпоинт с OpenAI-совместимым API
LLM_BASE_URL=https://foundation-models.api.cloud.ru/v1
LLM_MODEL=Qwen/Qwen2.5-32B-Instruct
LLM_API_KEY=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=700

# Эмбеддинги: local (sentence-transformers), openai или tfidf (офлайн-запас)
EMBEDDINGS_BACKEND=local
EMBEDDINGS_MODEL=intfloat/multilingual-e5-small

# Чанкинг и поиск
CHUNK_SIZE=700
CHUNK_OVERLAP=120
TOP_K=4
# Порог отсечки. Для e5 рабочее значение около 0.80, для tfidf около 0.25.
# MIN_SCORE=0.80

# Слои защиты от инъекций в документах
GUARD_ENABLED=true
